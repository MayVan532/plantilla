      function ensureInBody(el){ try{ if(el && el.parentNode !== document.body){ document.body.appendChild(el); } }catch(e){} }
      function lockScroll(){ try{ if(bodyOverflowSaved===null){ bodyOverflowSaved=document.body.style.overflow||''; } document.body.style.overflow='hidden'; }catch(e){} }
      function unlockScroll(){ try{ if(bodyOverflowSaved!==null){ document.body.style.overflow=bodyOverflowSaved; bodyOverflowSaved=null; } }catch(e){} }
      function openAlert(opts){
        opts = opts||{}; var type=opts.type||'info'; var t=opts.title|| (type==='success'?'Éxito': type==='error'?'Error':'Consulta');
        title.textContent=t; head.className='head '+(type==='success'?'success': type==='error'?'error':'info');
        rowLoad.style.display = opts.loading? 'flex':'none'; rowRes.style.display = opts.loading? 'none':'flex';
        if(!opts.loading){ var ok=(type==='success'); ico.className='ico '+(ok?'success':'error'); icoI.className= ok? 'fas fa-check':'fas fa-times'; msgTitle.textContent = opts.titleStrong || opts.message || (ok?'Consulta exitosa':'No se pudo consultar'); var det = opts.detail||''; try{ msgText.innerHTML = (det+'').replace(/\n/g,'<br>'); }catch(e){ msgText.textContent = det; } window.setTimeout(closeAlert,10000); }
        ensureInBody(modal); modal.style.display='flex'; lockScroll();
      }
      function closeAlert(){ modal.style.display='none'; unlockScroll(); }
      okBtn && okBtn.addEventListener('click', closeAlert);
      closeBtn && closeBtn.addEventListener('click', closeAlert);
      modal && modal.addEventListener('click', function(e){ if(e.target===modal) closeAlert(); });
      function setLoading(b){ if(!btn)return; if(b){ btn.disabled=true; btn.setAttribute('data-old',btn.textContent); btn.textContent='Consultando…'; btn.style.opacity='0.7'; btn.style.cursor='not-allowed'; } else { btn.disabled=false; btn.textContent=btn.getAttribute('data-old')||'Consultar'; btn.style.opacity=''; btn.style.cursor=''; } }
      function doQuery(){ var v=(input.value||'').replace(/\D+/g,'').trim(); if(v.length<14||v.length>17){ openAlert({type:'error', titleStrong:'IMEI inválido. Debe contener solo dígitos (14 a 17).'}); return; } openAlert({type:'info', loading:true}); setLoading(true); var fd=new FormData(); fd.append('imei', v); fetch('<?php echo BASE_URL; ?>personas/imeiApi', {method:'POST', body: fd}).then(function(r){return r.json().catch(function(){return {ok:false,message:'Respuesta inválida'};});}).then(function(j){ if(j&&j.ok){ var b=(j.body&&typeof j.body==='object')? j.body:{}; if(b.imei && typeof b.imei==='object'){ b=b.imei; } function pick(o){ for(var i=1;i<arguments.length;i++){ var k=arguments[i]; if(o!=null && Object.prototype.hasOwnProperty.call(o,k) && o[k]!=null && o[k]!== '') return o[k]; } return ''; } var df=b.deviceFeatures||b.devicefeatures||{}; var brand=pick(b,'brand','marca') || pick(df,'brand','marca'); var model=pick(b,'model','modelo') || pick(df,'model','modelo'); var homolog=pick(b,'homologated','homologado'); var blocked=(pick(b,'blocked')+'').toUpperCase(); var sub=pick(b,'sub_category','categoria'); var volte=(''+(pick(df,'volteCapable','volte'))).toUpperCase(); var esim=(''+(pick(b,'soportaESIM','esim', 'eSIM', 'soportaEsim', 'soporta_esim', 'supportEsim'))).toUpperCase(); var band28=(''+(pick(df,'band28')||pick(b,'band28'))).toUpperCase(); var kv=[]; if(brand){ kv.push(['Marca', brand]); } if(model){ kv.push(['Modelo', model]); } if(homolog){ kv.push(['Homologación', homolog]); } if(blocked){ kv.push(['Bloqueado', blocked]); } if(sub){ kv.push(['Categoría', sub]); } if(volte){ kv.push(['VoLTE', volte]); } if(esim){ kv.push(['eSIM', esim]); } if(band28){ kv.push(['Banda 28', band28]); }
          var html=''; if(kv.length>5){ html = '<div class="kv-grid">'+ kv.map(function(p){ return '<div class="kv-item"><b>'+p[0]+':</b> '+p[1]+'</div>'; }).join('') + '</div>'; } else { html = kv.map(function(p){ return '<div class="kv-item"><b>'+p[0]+':</b> '+p[1]+'</div>'; }).join(''); }
          var compatibleTitle='Consulta realizada'; var okCompat = (homolog && /COMPATIBLE/i.test(homolog)) && (blocked!=='SI' && blocked!=='TRUE'); if(okCompat){ compatibleTitle = 'Equipo compatible'; } else if(homolog){ compatibleTitle = homolog; }
          var m=(j.message&&typeof j.message==='string' && j.message!=='Consulta realizada')? j.message : compatibleTitle; openAlert({type:'success', titleStrong:m, detail:html}); } else { var em=(j&&j.message)? j.message : 'No se pudo consultar la compatibilidad.'; openAlert({type:'error', titleStrong:em}); } }).catch(function(){ openAlert({type:'error', titleStrong:'Error de red al consultar la compatibilidad.'}); }).finally(function(){ setLoading(false); }); }
      btn && btn.addEventListener('click', doQuery);
      if(input){ input.addEventListener('keydown', function(e){ if(e.key==='Enter'){ e.preventDefault(); doQuery(); } }); input.addEventListener('input', function(){ this.value=this.value.replace(/\D+/g,'').slice(0,17); }); }
    })();
  </script>

