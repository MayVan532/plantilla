  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
  <script>
    (function(){
      var mapEl = document.getElementById('mapCobertura');
      if (!mapEl) return;
      var map = L.map('mapCobertura');
      L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', { attribution: '&copy; OpenStreetMap' }).addTo(map);
      map.setView([23.6345, -102.5528], 5); // México

      var marker;
      function flyTo(lat, lon, txt){
        map.setView([lat, lon], 13);
        if (marker) map.removeLayer(marker);
        marker = L.marker([lat, lon]).addTo(map);
        if (txt) marker.bindPopup(txt).openPopup();
      }

      function geocode(q, cb){
        fetch('https://nominatim.openstreetmap.org/search?format=json&q=' + encodeURIComponent(q) + '&countrycodes=mx&limit=1', {headers:{'Accept-Language':'es'}})
          .then(function(r){return r.json();})
          .then(function(d){ if (d && d[0]) cb(d[0]); });
      }

      var cpBtn = document.getElementById('cpBtn');
      var cpInput = document.getElementById('cpInput');
      var cobModal = document.getElementById('cobModal');
      var cobModalHead = document.getElementById('cobModalHead');
      var cobModalTitle = document.getElementById('cobModalTitle');
      var cobRowLoading = document.getElementById('cobRowLoading');
      var cobRowResult  = document.getElementById('cobRowResult');
      var cobIcon       = document.getElementById('cobIcon');
      var cobIconI      = document.getElementById('cobIconI');
      var cobMsgTitle   = document.getElementById('cobMsgTitle');
      var cobMsgText    = document.getElementById('cobMsgText');
      var cobModalOk = document.getElementById('cobModalOk');
      var cobModalClose = document.getElementById('cobModalClose');

      var cobTimer = null;
      var bodyOverflowSaved = null;
      function ensureInBody(el){ try { if (el && el.parentNode !== document.body) { document.body.appendChild(el); } } catch(e){} }
      function lockScroll(){ try { if (bodyOverflowSaved === null) { bodyOverflowSaved = document.body.style.overflow || ''; } document.body.style.overflow = 'hidden'; } catch(e){} }
      function unlockScroll(){ try { if (bodyOverflowSaved !== null) { document.body.style.overflow = bodyOverflowSaved; bodyOverflowSaved = null; } } catch(e){} }
      function openAlert(opts){
        opts = opts || {};
        var type = opts.type || 'info';
        var title= opts.title|| (type==='success'?'Éxito': type==='error'?'Error':'Consulta');
        cobModalTitle.textContent = title;
        cobModalHead.className = 'head ' + (type==='success'?'success': type==='error'?'error':'info');
        cobRowLoading.style.display = opts.loading ? 'flex' : 'none';
        cobRowResult.style.display  = opts.loading ? 'none' : 'flex';
        if (!opts.loading){
          var isOk = (type === 'success');
          cobIcon.className = 'ico ' + (isOk ? 'success' : 'error');
          cobIconI.className = isOk ? 'fas fa-check' : 'fas fa-times';
          // Mostrar el mensaje principal en negritas y más grande
          var strongMsg = opts.titleStrong || opts.message || (isOk ? 'Consulta exitosa' : 'No se pudo consultar');
          cobMsgTitle.textContent = strongMsg;
          // Texto secundario opcional
          cobMsgText.textContent  = opts.detail || '';
          if (cobTimer) { clearTimeout(cobTimer); }
          cobTimer = setTimeout(closeAlert, 8000);
        }
        ensureInBody(cobModal);
        cobModal.style.display = 'flex';
        lockScroll();
      }
      function closeAlert(){ cobModal.style.display='none'; unlockScroll(); }
      cobModalOk && cobModalOk.addEventListener('click', closeAlert);
      cobModalClose && cobModalClose.addEventListener('click', closeAlert);
      cobModal && cobModal.addEventListener('click', function(e){ if (e.target === cobModal) closeAlert(); });

      function setLoading(loading){
        if (!cpBtn) return;
        if (loading){
          cpBtn.disabled = true;
          cpBtn.setAttribute('data-old', cpBtn.textContent);
          cpBtn.textContent = 'Consultando…';
          cpBtn.style.opacity = '0.7';
          cpBtn.style.cursor = 'not-allowed';
        } else {
          cpBtn.disabled = false;
          var old = cpBtn.getAttribute('data-old') || 'Consultar';
          cpBtn.textContent = old;
          cpBtn.style.opacity = '';
          cpBtn.style.cursor = '';
        }
      }

      function doQuery(){
        var v = (cpInput.value||'').trim();
        if (!/^\d{5}$/.test(v)) { openAlert({type:'error', message:'Ingresa un código postal válido de 5 dígitos.', loading:false}); return; }
        openAlert({type:'info', loading:true});
        setLoading(true);
        var fd = new FormData();
        fd.append('codigo_postal', v);
        fetch('<?php echo BASE_URL; ?>personas/coberturaApi', { method:'POST', body: fd })
          .then(function(r){ return r.json().catch(function(){ return {ok:false,message:'Respuesta inválida'}; }); })
          .then(function(j){
            if (j && j.ok){
              var m = (j.message && typeof j.message==='string') ? j.message : 'Consulta realizada';
              // Usar el mensaje del API como título fuerte para evitar duplicación
              openAlert({type:'success', title:'Éxito', titleStrong:m});
              geocode(v + ' México', function(res){ flyTo(res.lat, res.lon, 'CP ' + v); });
            } else {
              var em = (j&&j.message)? j.message : 'No se pudo consultar la cobertura.';
              // En error, también mostrar el mensaje fuerte
              openAlert({type:'error', title:'Error', titleStrong: em});
            }
          })
          .catch(function(){ openAlert({type:'error', title:'Error', titleStrong:'Error de red al consultar la cobertura.'}); })
          .finally(function(){ setLoading(false); });
      }

      cpBtn && cpBtn.addEventListener('click', doQuery);
      if (cpInput){
        cpInput.addEventListener('keydown', function(e){ if (e.key==='Enter') doQuery(); });
        cpInput.addEventListener('input', function(){ this.value = this.value.replace(/\D+/g,'').slice(0,5); });
      }
    })();
  </script>
</div>