                <!-- NUEVO: JS de checkout público (intercepta clics y lanza el flujo nuevo) -->
                <script>
                  (function(){
                    var DEBUGPAY = <?php echo (isset($_GET['debugcms']) && $_GET['debugcms']==='1') ? 'true' : 'false'; ?>;
                    function showDebug(obj){
                      try {
                        var box = document.getElementById('recargaDebugPanel');
                        if (!box) return;
                        box.style.display='block';
                        var pre = document.createElement('pre');
                        pre.style.margin='0';
                        pre.style.whiteSpace='pre-wrap';
                        pre.textContent = typeof obj === 'string' ? obj : JSON.stringify(obj, null, 2);
                        box.appendChild(pre);
                      } catch(_){ }
                    }
                    function ensureInBody(el){ try { if (el && el.parentNode !== document.body) { document.body.appendChild(el); } } catch(_){} }
                    function openDatos(cv){
                      document.getElementById('recargaCvPlan').value = cv || '';
                      document.getElementById('recargaNumero').value = '';
                      document.getElementById('recargaEmail').value = '';
                      document.getElementById('recargaError').style.display = 'none';
                      var m = document.getElementById('recargaDatosModal'); ensureInBody(m); m.style.display='flex';
                    }
                    function closeDatos(){ document.getElementById('recargaDatosModal').style.display='none'; }
                    function bindIframeEvents(ifr){
                      if (!ifr) return;
                      try {
                        ifr.onload = function(){ if (DEBUGPAY) showDebug({ iframe:'load', src: ifr.getAttribute('src')||'srcdoc' }); };
                        ifr.onerror = function(){ if (DEBUGPAY) showDebug({ iframe:'error', src: ifr.getAttribute('src')||'srcdoc' }); };
                      } catch(_){ }
                    }
                    function openIframe(url){ var ifr=document.getElementById('recargaIframe'); ifr.removeAttribute('srcdoc'); bindIframeEvents(ifr); ifr.src = url; var m=document.getElementById('recargaIframeModal'); ensureInBody(m); m.style.display='flex'; }
                    function openIframeHtml(html){ var ifr=document.getElementById('recargaIframe'); bindIframeEvents(ifr); ifr.src='about:blank'; try{ ifr.srcdoc = html; }catch(e){ /* fallback se hará con URL si aplica */ } var m=document.getElementById('recargaIframeModal'); ensureInBody(m); m.style.display='flex'; }
                    function openHtmlNewTab(html){ try{ var w = window.open('about:blank','_blank'); if (w && w.document){ w.document.open(); w.document.write(html); w.document.close(); } } catch(_){ /* noop */ } }
                    function closeIframe(){ document.getElementById('recargaIframe').src='about:blank'; document.getElementById('recargaIframeModal').style.display='none'; }

                    var c1 = document.getElementById('recargaDatosClose'); if (c1) c1.addEventListener('click', closeDatos);
                    var c2 = document.getElementById('recargaIframeClose'); if (c2) c2.addEventListener('click', closeIframe);

                    // Intercepta antes de listeners existentes
                    document.addEventListener('click', function(e){
                      var el = e.target && e.target.closest ? e.target.closest('.lkp-recargar-btn') : null;
                      if (!el) return;
                      // Importante: usar SIEMPRE cv_plan y NO offeringId
                      var cv = el.getAttribute('data-cv') || '';
                      if (!cv) return; // si no hay cv, deja flujo viejo
                      e.preventDefault();
                      e.stopImmediatePropagation();
                      openDatos(cv);
                    }, true);

                    var goBtn = document.getElementById('recargaContinuar');
                    if (goBtn) {
                      goBtn.addEventListener('click', function(){
                        var cv = document.getElementById('recargaCvPlan').value.trim();
                        var numEl = document.getElementById('recargaNumero');
                        var mailEl = document.getElementById('recargaEmail');
                        var num = numEl.value.replace(/[^0-9]/g,'');
                        var mail = mailEl.value.trim();
                        var err = document.getElementById('recargaError');
                        // limpiar estilos
                        [numEl, mailEl].forEach(function(el){ el.style.borderColor=''; el.style.backgroundColor=''; });
                        var errores=[];
                        if (cv === '') { errores.push('Falta el plan (cv_plan).'); }
                        if (num.length !== 10) { errores.push('El número debe tener 10 dígitos.'); numEl.style.borderColor='#ef4444'; numEl.style.backgroundColor='#fef2f2'; }
                        if (mail === '' || !/^\S+@\S+\.\S+$/.test(mail)) { errores.push('Correo inválido.'); mailEl.style.borderColor='#ef4444'; mailEl.style.backgroundColor='#fef2f2'; }
                        if (errores.length){ err.innerHTML='<div style="background:#fee2e2;border:1px solid #fecaca;color:#991b1b;padding:8px 10px;border-radius:6px;">'+errores.join('<br>')+'</div>'; err.style.display='block'; return; }
                        err.style.display='none';

                        var fd = new FormData(); fd.append('cv_plan', cv); fd.append('numero_data', num); fd.append('email', mail); if (DEBUGPAY) fd.append('debugpay','1');
                        fetch('<?php echo BASE_URL; ?>payments/crearCheckoutRecarga', { method:'POST', body: fd })
                          .then(function(r){ return r.json().catch(function(){ return {success:false, message:'Respuesta inválida'}; }); })
                          .then(function(j){ if (DEBUGPAY && j){ showDebug(j.debug || j); }
                            // Si hay HTML crudo en debug, ofrecer enlace para abrirlo en nueva pestaña
                            if (DEBUGPAY && j && j.debug && typeof j.debug.html === 'string' && j.debug.html.length > 0) {
                              try {
                                var blobUrl = URL.createObjectURL(new Blob([j.debug.html], {type:'text/html'}));
                                showDebug({ open_html: blobUrl });
                                (function(){
                                  var box = document.getElementById('recargaDebugPanel');
                                  if (!box) return;
                                  var a = document.createElement('a'); a.href = blobUrl; a.target = '_blank'; a.rel='noopener'; a.textContent = 'Abrir HTML de respuesta en nueva pestaña';
                                  a.style.display='inline-block'; a.style.margin='6px 0'; a.style.color='#0ea5a6';
                                  box.appendChild(a);
                                })();
                              } catch(_){ }
                            }
                            if (j && j.success){
                              // Si el backend incluyó HTML crudo, úsalo directamente en srcdoc (aplica aun sin debug)
                              if (typeof j.html === 'string' && j.html.length > 0) {
                                try { closeDatos(); openIframeHtml(j.html); if (DEBUGPAY) showDebug({ note:'usando iframe.srcdoc por html en respuesta' }); return; } catch(_e) {}
                              }
                              // Preferir srcdoc cuando el backend regresó HTML crudo (raw_html) en modo debug, aunque exista iframe_url
                              if (DEBUGPAY && j.debug && (j.debug.raw_html || j.raw_html) && typeof j.debug.html === 'string' && j.debug.html.length > 0) {
                                try {
                                  closeDatos(); openIframeHtml(j.debug.html);
                                  showDebug({ note:'raw_html detectado; usando iframe.srcdoc con HTML devuelto' });
                                  return; // ya abrimos
                                } catch(e) {
                                  try {
                                    var blob = new Blob([j.debug.html], {type:'text/html'});
                                    url = URL.createObjectURL(blob);
                                    showDebug({ note:'Fallback a Blob URL por debug.html', blob_url:url });
                                  } catch(_e) { /* se mantiene url actual */ }
                                }
                              }
                              // En flujo normal, usar iframe_url del backend
                              var url = (j.iframe_url && typeof j.iframe_url === 'string' && j.iframe_url.length>0) ? j.iframe_url : 'about:blank';
                              closeDatos(); openIframe(url);
                            } else {
                              err.textContent=(j&&j.message)?j.message:'No se pudo crear el checkout.'; err.style.display='block';
                            } })
                          .catch(function(){ err.textContent='Error de red.'; err.style.display='block'; });
                      });
                    }
                  })();
                </script>

