                <!-- JS de modales viejo (se mantiene, pero el flujo nuevo intercepta clics antes) -->
                <script>
                (function() {
                    var modal = document.getElementById('lkpPagoModal');
                    var modalTarjeta = document.getElementById('lkpTarjetaModal');
                    var modalEfectivo = document.getElementById('lkpEfectivoModal');
                    if (!modal) return;

                    function abrirModal(event) {
                        if (event) event.preventDefault();
                        // setear título del plan seleccionado en headers de modales
                        var a = event ? event.currentTarget : null;
                        var tituloPlan = a ? (a.getAttribute('data-titulo') || '') : '';
                        var t1 = document.getElementById('lkpPlanTituloTarjeta');
                        var t2 = document.getElementById('lkpPlanTituloEfectivo');
                        if (t1 && tituloPlan) t1.textContent = tituloPlan;
                        if (t2 && tituloPlan) t2.textContent = tituloPlan;
                        if (modal) { modal.style.display = 'flex'; }
                    }

                    function cerrarModal(event) {
                        if (event) event.preventDefault();
                        if (modal) { modal.style.display = 'none'; }
                    }

                    function abrirTarjeta(event) {
                        if (event) event.preventDefault();
                        cerrarModal();
                        if (modalTarjeta) {
                            modalTarjeta.style.display = 'flex';
                        }
                    }

                    function cerrarTarjeta(event) {
                        if (event) event.preventDefault();
                        if (modalTarjeta) {
                            modalTarjeta.style.display = 'none';
                        }
                    }

                    function abrirEfectivo(event) {
                        if (event) event.preventDefault();
                        cerrarModal();
                        if (modalEfectivo) {
                            modalEfectivo.style.display = 'flex';
                        }
                    }

                    function cerrarEfectivo(event) {
                        if (event) event.preventDefault();
                        if (modalEfectivo) {
                            modalEfectivo.style.display = 'none';
                        }
                    }

                    var botones = document.querySelectorAll('.lkp-recargar-btn');
                    for (var i = 0; i < botones.length; i++) {
                        botones[i].addEventListener('click', abrirModal);
                    }

                    var btnCerrar = document.getElementById('lkpCerrarModal');
                    if (btnCerrar) { btnCerrar.addEventListener('click', cerrarModal); }

                    var btnTarjeta = document.getElementById('lkpPagarTarjeta');
                    if (btnTarjeta) { btnTarjeta.addEventListener('click', abrirTarjeta); }

                    var btnEfectivo = document.getElementById('lkpPagarEfectivo');
                    if (btnEfectivo) { btnEfectivo.addEventListener('click', abrirEfectivo); }

                    var cierresTarjeta = document.querySelectorAll('.lkp-tarjeta-close');
                    for (var j = 0; j < cierresTarjeta.length; j++) { cierresTarjeta[j].addEventListener('click', cerrarTarjeta); }

                    var cierresEfectivo = document.querySelectorAll('.lkp-efectivo-close');
                    for (var k = 0; k < cierresEfectivo.length; k++) { cierresEfectivo[k].addEventListener('click', cerrarEfectivo); }

                    var modalTarjetaBox = modalTarjeta ? modalTarjeta.querySelector('.modal-card') : null;
                    if (modalTarjetaBox) {
                        modalTarjetaBox.addEventListener('click', function(e) { e.stopPropagation(); });
                    }
                    var modalEfectivoBox = modalEfectivo ? modalEfectivo.querySelector('.modal-card') : null;
                    if (modalEfectivoBox) {
                        modalEfectivoBox.addEventListener('click', function(e) { e.stopPropagation(); });
                    }

                    // Cerrar al hacer click en el overlay oscuro
                    if (modal) modal.addEventListener('click', cerrarModal);
                    if (modalTarjeta) modalTarjeta.addEventListener('click', cerrarTarjeta);
                    if (modalEfectivo) modalEfectivo.addEventListener('click', cerrarEfectivo);
                })();
                </script>

