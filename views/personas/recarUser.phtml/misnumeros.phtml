  <script>
    (function(){
      var tbody = document.getElementById('numsTbody');
      var info  = document.getElementById('numsInfo');
      var buscar= document.getElementById('filtroBuscar');
      var btnAdd= document.getElementById('btnAgregarNumero');
      var modal = document.getElementById('numModal');
      var mTitle= document.getElementById('numModalTitle');
      var mClose= document.getElementById('numModalClose');
      var mSave = document.getElementById('numModalSave');
      var inNum = document.getElementById('num_input');
      var inAlias=document.getElementById('alias_input');
      var inEmail=document.getElementById('email_input');
      var inCv  = document.getElementById('cv_usuarionumero');
      // Alert modal refs
      var alertM = document.getElementById('numsAlertModal');
      var aTitle = document.getElementById('numsAlertTitle');
      var aClose = document.getElementById('numsAlertClose');
      var aRowL  = document.getElementById('numsRowLoading');
      var aRowR  = document.getElementById('numsRowResult');
      var aIcon  = document.getElementById('numsIcon');
      var aIconI = document.getElementById('numsIconI');
      var aMsgT  = document.getElementById('numsMsgTitle');
      var aMsgTx = document.getElementById('numsMsgText');
      var aActs  = document.getElementById('numsActions');
      var aOk    = document.getElementById('numsOk');
      var aAuto  = document.getElementById('numsAutoCloseHint');
      var autoTimer=null, autoInt=null;

      // Confirm modal refs
      var cM = document.getElementById('numsConfirm');
      var cClose = document.getElementById('numsConfirmClose');
      var cText  = document.getElementById('numsConfirmText');
      var cNo    = document.getElementById('numsConfirmNo');
      var cYes   = document.getElementById('numsConfirmYes');
      var cCb    = null;
      var rows = [];
      var page = 1;
      var per  = 10;

      function onlyDigits(s){ return (s||'').replace(/\D+/g,''); }
      function emailOk(v){ return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v); }
      function ensureBody(el){ try{ if(el && el.parentNode!==document.body){ document.body.appendChild(el);} }catch(e){} }
      function openAlert(opts){
        opts=opts||{}; var t=opts.title|| (opts.loading?'Procesando':'Aviso'); aTitle.textContent=t;
        aRowL.style.display=opts.loading?'flex':'none'; aRowR.style.display=opts.loading?'none':'flex';
        if(autoTimer){ clearTimeout(autoTimer); autoTimer=null; }
        if(opts.loading){ if(aAuto){ aAuto.style.display='none'; } if(autoTimer){clearTimeout(autoTimer); autoTimer=null;} if(autoInt){clearInterval(autoInt); autoInt=null;} ensureBody(alertM); alertM.style.display='flex'; return; }
        var ok=(opts.type||'success')==='success'; aIcon.className='ico '+(ok?'success':'error'); aIconI.className= ok? 'fas fa-check':'fas fa-times';
        aMsgT.textContent = opts.message|| (ok?'Operación exitosa':'Operación fallida');
        try{ aMsgTx.innerHTML=(opts.detail||'')+''; }catch(e){ aMsgTx.textContent=opts.detail||''; }
        aActs.style.display='flex'; aOk.onclick=function(){ closeAlert(); };
        ensureBody(alertM); alertM.style.display='flex';
        var ms = (typeof opts.autoCloseMs==='number' && opts.autoCloseMs>=1000)? opts.autoCloseMs : 6000;
        if(aAuto){
          var remaining = Math.round(ms/1000);
          aAuto.style.display='block';
          aAuto.textContent = 'Este mensaje se cerrará automáticamente en '+remaining+' segundos.';
          if(autoInt){ clearInterval(autoInt); autoInt=null; }
          autoInt = setInterval(function(){
            remaining -= 1;
            if(remaining <= 0){ clearInterval(autoInt); autoInt=null; return; }
            try{ aAuto.textContent = 'Este mensaje se cerrará automáticamente en '+remaining+' segundos.'; }catch(e){}
          }, 1000);
        }
        autoTimer=setTimeout(closeAlert, ms);
      }
      function closeAlert(){ if(autoTimer){clearTimeout(autoTimer); autoTimer=null;} if(autoInt){clearInterval(autoInt); autoInt=null;} alertM.style.display='none'; aActs.style.display='none'; }

      function openConfirm(text, cb){ cCb = typeof cb==='function'? cb:null; cText.textContent=text||'¿Seguro que deseas continuar?'; ensureBody(cM); cM.style.display='flex'; }
      function closeConfirm(){ cM.style.display='none'; cCb=null; }
      cNo && cNo.addEventListener('click', closeConfirm);
      cClose && cClose.addEventListener('click', closeConfirm);
      cYes && cYes.addEventListener('click', function(){ var fn=cCb; closeConfirm(); if(fn) fn(); });
      aClose && aClose.addEventListener('click', function(){ closeAlert(); });
      alertM && alertM.addEventListener('click', function(e){ if(e.target===alertM){ closeAlert(); } });
      function openModal(edit){ mTitle.textContent = edit? 'Editar número' : 'Agregar número'; modal.style.display='flex'; }
      function closeModal(){ modal.style.display='none'; inCv.value=''; inNum.value=''; inAlias.value=''; inEmail.value=''; }

      function getFiltered(){
        var q = (buscar.value||'').toLowerCase();
        return rows.filter(function(r){ return !q || (String(r.numero_lista_usuario||'').toLowerCase().indexOf(q)>-1) || (String(r.alias||'').toLowerCase().indexOf(q)>-1) || (String(r.email||'').toLowerCase().indexOf(q)>-1); });
      }

      function render(){
        var data = getFiltered();
        var total = data.length;
        if(!total){ tbody.innerHTML = '<tr><td colspan="3" style="padding:16px 10px; text-align:center; color:#9ca3af;">Sin registros</td></tr>'; info.textContent='Mostrando 0 de 0'; setPagerState(0,0); return; }
        var pages = Math.max(1, Math.ceil(total / per));
        if(page>pages) page=pages;
        var start=(page-1)*per, end=Math.min(start+per,total);
        var slice = data.slice(start,end);
        tbody.innerHTML = slice.map(function(r){
          var cv = r.cv_usuarionumero!=null? r.cv_usuarionumero:'';
          var num= r.numero_lista_usuario||'';
          var alias = r.alias||'';
          var email = r.email||'';
          return '<tr>'+
            '<td style="padding:10px; border-bottom:1px solid #f1f5f9;">'+num+'</td>'+
            '<td style="padding:10px; border-bottom:1px solid #f1f5f9;">'+alias+'</td>'+
            '<td style="padding:8px; border-bottom:1px solid #f1f5f9;">'+
              '<button data-act="edit" data-cv="'+cv+'" data-num="'+num+'" data-alias="'+alias.replace(/"/g,'&quot;')+'" data-email="'+email.replace(/"/g,'&quot;')+'" style="border:1px solid #d1d5db; background:#fff; padding:4px 8px; border-radius:4px; font-size:12px; margin-right:6px;">Editar</button>'+
              '<button data-act="del" data-cv="'+cv+'" style="border:1px solid #ef4444; background:#fff; color:#ef4444; padding:4px 8px; border-radius:4px; font-size:12px;">Eliminar</button>'+
            '</td>'+
          '</tr>';
        }).join('');
        info.textContent='Mostrando registros del '+(start+1)+' al '+end+' de un total de '+total+' registros';
        setPagerState(page, Math.max(1, Math.ceil(total/per)));
      }

      function setPagerState(p, pages){
        var prev=document.getElementById('numsPrev');
        var next=document.getElementById('numsNext');
        if(prev){ prev.disabled=(p<=1||pages<=1); prev.style.opacity=prev.disabled?'.6':'1'; prev.style.cursor=prev.disabled?'not-allowed':'pointer'; }
        if(next){ next.disabled=(p>=pages||pages<=1); next.style.opacity=next.disabled?'.6':'1'; next.style.cursor=next.disabled?'not-allowed':'pointer'; }
      }

      function fetchList(){
        tbody.innerHTML='<tr><td colspan="3" style="padding:16px 10px; text-align:center; color:#9ca3af;">Cargando…</td></tr>';
        fetch('<?php echo BASE_URL; ?>personas/userNumbersListApi', {method:'POST'}).then(function(r){return r.json().catch(function(){return {ok:false};});}).then(function(j){
          if(j && j.ok){ rows = (j.body && j.body.data) ? j.body.data : []; }
          else { rows = []; }
          render();
        }).catch(function(){ rows=[]; render(); });
      }

      function save(isEdit){
        var num = onlyDigits(inNum.value).slice(0,10); inNum.value=num;
        var alias=(inAlias.value||'').trim(); var email=(inEmail.value||'').trim();
        if(!isEdit && num.length!==10){ openAlert({type:'error', message:'Número inválido (10 dígitos)'}); return; }
        if(alias==='' || alias.length>50){ openAlert({type:'error', message:'Alias inválido'}); return; }
        if(email==='' || !emailOk(email)){ openAlert({type:'error', message:'Correo inválido'}); return; }
        openAlert({loading:true, title:'Guardando'});
        var fd=new FormData();
        if(isEdit){ fd.append('cv_usuarionumero', inCv.value||''); if(num) fd.append('numero', num); if(alias) fd.append('alias', alias); if(email) fd.append('email', email); var url='<?php echo BASE_URL; ?>personas/userNumbersEditApi'; }
        else { fd.append('numero', num); fd.append('alias', alias); fd.append('email', email); var url='<?php echo BASE_URL; ?>personas/userNumbersRegisterApi'; }
        fetch(url,{method:'POST', body: fd}).then(function(r){return r.json().catch(function(){return {ok:false};});}).then(function(j){
          if(j&&j.ok){ openAlert({type:'success', message:j.message||'Guardado correctamente'}); closeModal(); fetchList(); }
          else { openAlert({type:'error', message:(j&&j.message)? j.message:'No se pudo guardar'}); }
        }).catch(function(){ openAlert({type:'error', message:'Error de red'}); });
      }

      function del(cv){ if(!cv){ return; } openConfirm('¿Eliminar número?', function(){ openAlert({loading:true, title:'Eliminando'}); var fd=new FormData(); fd.append('cv_usuarionumero', String(cv)); fetch('<?php echo BASE_URL; ?>personas/userNumbersDeleteApi',{method:'POST', body: fd}).then(function(r){return r.json().catch(function(){return {ok:false};});}).then(function(j){ if(j&&j.ok){ openAlert({type:'success', message:j.message||'Eliminado'}); fetchList(); } else { openAlert({type:'error', message:(j&&j.message)? j.message:'No se pudo eliminar'}); } }).catch(function(){ openAlert({type:'error', message:'Error de red'}); }); }); }

      // Handlers
      btnAdd && btnAdd.addEventListener('click', function(e){ e.preventDefault(); inCv.value=''; inNum.value=''; inAlias.value=''; inEmail.value=''; openModal(false); });
      mClose && mClose.addEventListener('click', function(){ closeModal(); });
      mSave  && mSave.addEventListener('click', function(){ var isEdit = !!(inCv.value||''); save(isEdit); });
      buscar && buscar.addEventListener('input', function(){ page=1; render(); });
      var prevBtn=document.getElementById('numsPrev');
      var nextBtn=document.getElementById('numsNext');
      prevBtn && prevBtn.addEventListener('click', function(){ if(page>1){ page--; render(); } });
      nextBtn && nextBtn.addEventListener('click', function(){ var total=getFiltered().length; var pages=Math.max(1, Math.ceil(total/per)); if(page<pages){ page++; render(); } });
      document.addEventListener('click', function(e){
        var b = e.target;
        if(b && b.getAttribute('data-act')==='edit'){
          inCv.value = b.getAttribute('data-cv')||'';
          inNum.value = b.getAttribute('data-num')||'';
          inAlias.value = b.getAttribute('data-alias')||'';
          inEmail.value = b.getAttribute('data-email')||'';
          openModal(true);
        } else if(b && b.getAttribute('data-act')==='del'){
          del(b.getAttribute('data-cv')||'');
        }
      });

      // Input masking
      inNum && inNum.addEventListener('input', function(){ this.value = onlyDigits(this.value).slice(0,10); });

      // Init
      fetchList();
    })();
  </script>
</div>


