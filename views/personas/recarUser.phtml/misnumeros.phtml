    <div class="box">
      <div class="head"><span>Confirmar</span><button type="button" id="numsConfirmClose" class="close-btn">Cerrar</button></div>
      <div class="body"><div class="txt-sub" id="numsConfirmText">¿Seguro que deseas continuar?</div></div>
      <div class="actions"><button id="numsConfirmNo" class="btn sec" type="button">Cancelar</button><button id="numsConfirmYes" class="btn pri" type="button">Aceptar</button></div>
    </div>
