        <div class="row" id="numsRowResult" style="display:none;"><div id="numsIcon" class="ico success"><i id="numsIconI" class="fas fa-check" aria-hidden="true"></i></div><div><div id="numsMsgTitle" class="txt-title">Resultado</div><div id="numsMsgText" class="txt-sub"></div><div id="numsAutoCloseHint" class="txt-sub" style="margin-top:8px; color:#64748b; font-size:12px;">Este mensaje se cerrará automáticamente en 6 segundos.</div></div></div>
