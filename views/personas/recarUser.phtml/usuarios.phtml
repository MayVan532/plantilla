<script>
(function(){
  var DEBUGPAY = <?php echo (isset($_GET['debugcms']) && $_GET['debugcms']==='1') ? 'true' : 'false'; ?>;
  function showDebug(obj){ try { var box=document.getElementById('actDebugPanel'); if(!box) return; box.style.display='block'; var pre=document.createElement('pre'); pre.style.margin='0'; pre.style.whiteSpace='pre-wrap'; pre.textContent= typeof obj==='string'? obj: JSON.stringify(obj,null,2); box.appendChild(pre);}catch(_){}}
  // Prefill se hace desde servidor; sin fetch adicional

  function openActDatos(cv){
    var h=document.getElementById('actCvPlan'); if(h) h.value=cv||'';
    var e=document.getElementById('actError'); if(e){ e.style.display='none'; e.textContent=''; }
    // Prefill seguro desde perfil si los campos están vacíos
    try {
      var vNombre = <?php echo json_encode($prefNombre); ?>;
      var vApPat  = <?php echo json_encode($prefApPat); ?>;
      var vApMat  = <?php echo json_encode($prefApMat); ?>;
      var vTel    = <?php echo json_encode($prefTel); ?>;
      var vMail   = <?php echo json_encode($prefEmail); ?>;
      var iNombre = document.getElementById('actNombre'); if (iNombre && (iNombre.value||'').trim()==='' && vNombre) iNombre.value = vNombre;
      var iApPat  = document.getElementById('actApPat');  if (iApPat  && (iApPat.value||'').trim()===''  && vApPat)  iApPat.value  = vApPat;
      var iApMat  = document.getElementById('actApMat');  if (iApMat  && (iApMat.value||'').trim()===''  && vApMat)  iApMat.value  = vApMat;
      var iTel    = document.getElementById('actTelefono'); if (iTel && (iTel.value||'').trim()==='' && vTel) iTel.value = vTel;
      var iMail   = document.getElementById('actEmail'); if (iMail && (iMail.value||'').trim()==='' && vMail) iMail.value = vMail;
    } catch(_){}
    // Sin fetch adicional; valores ya vienen prellenados del servidor
    var m=document.getElementById('actDatosModal'); if(m){ m.style.display='flex'; }
  }
  function closeActDatos(){ var m=document.getElementById('actDatosModal'); if(m){ m.style.display='none'; } }
  function bindActIframeEvents(f){ if(!f) return; try { f.onload=function(){ if (DEBUGPAY) showDebug({iframe:'load', src: f.getAttribute('src')||'srcdoc'}); }; f.onerror=function(){ if (DEBUGPAY) showDebug({iframe:'error', src: f.getAttribute('src')||'srcdoc'}); }; } catch(_){}}
  function openActIframe(url){ var f=document.getElementById('actIframe'); if(f){ f.removeAttribute('srcdoc'); bindActIframeEvents(f); f.src=url; } var m=document.getElementById('actIframeModal'); if(m){ m.style.display='flex'; } }
  function openActIframeHtml(html){ var f=document.getElementById('actIframe'); if(f){ bindActIframeEvents(f); f.src='about:blank'; try{ f.srcdoc=html; }catch(e){} } var m=document.getElementById('actIframeModal'); if(m){ m.style.display='flex'; } }
  function closeActIframe(){ var f=document.getElementById('actIframe'); if(f){ f.src='about:blank'; } var m=document.getElementById('actIframeModal'); if(m){ m.style.display='none'; } }

  var cx=document.getElementById('actDatosClose'); if(cx) cx.addEventListener('click', closeActDatos);
  var ix=document.getElementById('actIframeClose'); if(ix) ix.addEventListener('click', closeActIframe);

  document.addEventListener('click', function(e){
    var btn=e.target && e.target.closest? e.target.closest('.comprar-btn'):null;
    if(!btn) return; e.preventDefault(); e.stopImmediatePropagation();
    var old=document.getElementById('comprarModal'); if(old){ old.style.display='none'; }
    var cv=btn.getAttribute('data-cv')||''; openActDatos(cv);
  }, true);

  var go=document.getElementById('actContinuar');
  if(go){ go.addEventListener('click', function(){
    var cv=(document.getElementById('actCvPlan').value||'').trim();
    var nombre=(document.getElementById('actNombre').value||'').trim();
    var apPat=(document.getElementById('actApPat').value||'').trim();
    var apMat=(document.getElementById('actApMat').value||'').trim();
    var genero='1'; // fijo temporalmente
    var fNac=(document.getElementById('actFechaNac').value||'').trim();
    var tel=(document.getElementById('actTelefono').value||'').replace(/[^0-9]/g,'');
    var email=(document.getElementById('actEmail').value||'').trim();
    var cp=(document.getElementById('actCP').value||'').trim();
    var col=(document.getElementById('actColonia').value||'').trim();
    var calle=(document.getElementById('actCalle').value||'').trim();
    var noext=(document.getElementById('actNoExt').value||'').trim();
    var noint=(document.getElementById('actNoInt').value||'').trim();
    var refs=(document.getElementById('actRefs').value||'').trim();
    var obs=(document.getElementById('actObs').value||'').trim();
    var err=document.getElementById('actError');

    // Limpia estilos previos
    function clearInvalid(id){ var el=document.getElementById(id); if(el){ el.style.borderColor=''; el.style.backgroundColor=''; } }
    function markInvalid(id){ var el=document.getElementById(id); if(el){ el.style.borderColor='#ef4444'; el.style.backgroundColor='#fef2f2'; } }
    ['actNombre','actApPat','actApMat','actFechaNac','actTelefono','actEmail','actCP','actColonia','actCalle','actNoExt','actNoInt','actRefs','actObs'].forEach(clearInvalid);

    var errores=[];
    if(cv===''){ errores.push('Falta el plan de activación.'); }
    if(nombre===''){ errores.push('Nombre es requerido.'); markInvalid('actNombre'); }
    if(apPat===''){ errores.push('Apellido paterno es requerido.'); markInvalid('actApPat'); }
    if(apMat===''){ errores.push('Apellido materno es requerido.'); markInvalid('actApMat'); }
    if(fNac===''){ errores.push('Fecha de nacimiento es requerida.'); markInvalid('actFechaNac'); }
    if(tel.length!==10){ errores.push('El número debe tener 10 dígitos.'); markInvalid('actTelefono'); }
    if(email===''||!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)){ errores.push('Correo inválido.'); markInvalid('actEmail'); }
    if(!/^\d{5}$/.test(cp)){ errores.push('Código postal debe ser de 5 dígitos.'); markInvalid('actCP'); }
    if(col===''){ errores.push('Colonia es requerida.'); markInvalid('actColonia'); }
    if(calle===''){ errores.push('Calle es requerida.'); markInvalid('actCalle'); }
    if(noext===''){ errores.push('Número exterior es requerido.'); markInvalid('actNoExt'); }
    if(noint===''){ errores.push('Número interior es requerido.'); markInvalid('actNoInt'); }
    if(refs===''){ errores.push('Referencias son requeridas.'); markInvalid('actRefs'); }
    if(obs===''){ errores.push('Observaciones son requeridas.'); markInvalid('actObs'); }

    if(errores.length>0){ err.innerHTML = '<div style="background:#fee2e2;border:1px solid #fecaca;color:#991b1b;padding:8px 10px;border-radius:6px;">'+ errores.join('<br>') +'</div>'; err.style.display='block'; return; }

    err.style.display='none';

    var fd=new FormData();
    fd.append('nombre', nombre);
    fd.append('apellido_paterno', apPat);
    fd.append('apellido_materno', apMat);
    fd.append('correo_electronico', email);
    fd.append('genero_id', '1');
    fd.append('fecha_nacimiento', fNac);
    fd.append('cv_plan', cv);
    fd.append('numero_telefono', tel);
    fd.append('codigo_postal', cp);
    fd.append('colonia', col);
    fd.append('calle', calle);
    fd.append('numero_exterior', noext);
    fd.append('numero_interior', noint);
    fd.append('referencias', refs);
    fd.append('observaciones', obs);

    if (DEBUGPAY) fd.append('debugpay','1');
    fetch('<?php echo BASE_URL; ?>payments/crearCheckoutActivacion', { method:'POST', body: fd })
      .then(function(r){ return r.json().catch(function(){ return {success:false, message:'Respuesta inválida'}; }); })
      .then(function(j){ if (DEBUGPAY && j){ showDebug(j.debug || j); }
        if (j && j.success){
          if (typeof j.html === 'string' && j.html.length>0) { try { closeActDatos(); openActIframeHtml(j.html); if (DEBUGPAY) showDebug({note:'usando iframe.srcdoc por html en respuesta'}); return; } catch(_e){} }
          var url = (j.iframe_url && typeof j.iframe_url==='string' && j.iframe_url.length>0) ? j.iframe_url : 'about:blank';
          closeActDatos(); openActIframe(url);
        } else { err.innerHTML = '<div style="background:#fee2e2;border:1px solid #fecaca;color:#991b1b;padding:8px 10px;border-radius:6px;">'+ ((j&&j.message)? j.message : 'No se pudo crear el checkout.') +'</div>'; err.style.display='block'; } })
      .catch(function(){ err.textContent='Error de red.'; err.style.display='block'; });
  }); }
})();
</script>
