            $profile = (isset($this->profile) && is_array($this->profile)) ? $this->profile : [];
            $dbgProfile = ['method'=>'none'];
            if (empty($profile)) {
              try {
                if (!class_exists('TokenApiExterno')) {
                  $lib = ROOT . 'libs' . DS . 'class.TokenApiExterno.php';
                  if (is_readable($lib)) { require_once $lib; }
                }
                if (class_exists('TokenApiExterno')) {
                  $auth = TokenApiExterno::obtenerAuthorizationHeader();
                  $ctx = stream_context_create([
                    'http' => [
                      'method' => 'GET',
                      'header' => implode("\r\n", array_filter([
                        'Accept: application/json',
                        // En controladores se usa 'Authorization: ' . TokenApiExterno::obtenerAuthorizationHeader()
                        is_string($auth) && $auth !== '' ? ('Authorization: ' . $auth) : null,
                      ]) ),
                      'timeout' => 10,
                    ]
                  ]);
                  $resp = @file_get_contents('https://apis.likephone.mx/api/v1/whitelabels/generic/account/profile', false, $ctx);
                  $json = is_string($resp) ? json_decode($resp, true) : null;
                  if (is_array($json)) { 
                    $profile = isset($json['data']) && is_array($json['data']) ? $json['data'] : $json; 
                    $dbgProfile = ['method'=>'fopen','ok'=>true];
                  } else {
                    // Fallback con cURL como en Mi Perfil
                    if (function_exists('curl_init')) {
                      $ch = curl_init('https://apis.likephone.mx/api/v1/whitelabels/generic/account/profile');
                      $hdrs = array_values(array_filter([
                        'Accept: application/json',
                        is_string($auth) && $auth !== '' ? ('Authorization: ' . $auth) : null,
                      ]));
                      curl_setopt_array($ch, [
                        CURLOPT_RETURNTRANSFER => true,
                        CURLOPT_HTTPGET => true,
                        CURLOPT_HTTPHEADER => $hdrs,
                        CURLOPT_TIMEOUT => 15,
                        CURLOPT_CONNECTTIMEOUT => 8,
                        CURLOPT_SSL_VERIFYPEER => true,
                        CURLOPT_SSL_VERIFYHOST => 2,
                      ]);
                      $cResp = curl_exec($ch);
                      $cHttp = (int)curl_getinfo($ch, CURLINFO_HTTP_CODE);
                      $cErr  = curl_error($ch);
                      curl_close($ch);
                      $cJson = is_string($cResp) ? json_decode($cResp, true) : null;
                      if (is_array($cJson)) {
                        $profile = isset($cJson['data']) && is_array($cJson['data']) ? $cJson['data'] : $cJson;
                        $dbgProfile = ['method'=>'curl','ok'=>($cHttp>=200&&$cHttp<300),'http'=>$cHttp];
                      } else {
                        $dbgProfile = ['method'=>'curl','ok'=>false,'http'=>$cHttp,'error'=>$cErr?:'no-json'];
                      }
                    } else {
                      $dbgProfile = ['method'=>'fopen','ok'=>false,'error'=>'curl_missing'];
                    }
                  }
                }
              } catch (\Throwable $e) { /* silencio */ }
            }
            $prefNombre = isset($profile['nombre']) ? (string)$profile['nombre'] : '';
            $prefApPat = isset($profile['apellido_paterno']) ? (string)$profile['apellido_paterno'] : '';
            $prefApMat = isset($profile['apellido_materno']) ? (string)$profile['apellido_materno'] : '';
            $prefTel = isset($profile['numero_telefono']) ? (string)$profile['numero_telefono'] : (isset($profile['telefono']) ? (string)$profile['telefono'] : '');
            $prefEmail = isset($profile['email']) ? (string)$profile['email'] : '';
          ?>

