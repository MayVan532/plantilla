              <div style="display:flex; gap:6px;">
                <button id="mcPrev" type="button" style="border:1px solid #00bcd4; background:#00bcd4; color:#f9fafb; font-size:12px; padding:4px 10px; border-radius:4px;">Anterior</button>
                <button id="mcNext" type="button" style="border:1px solid #00bcd4; background:#00bcd4; color:#f9fafb; font-size:12px; padding:4px 10px; border-radius:4px;">Siguiente</button>
