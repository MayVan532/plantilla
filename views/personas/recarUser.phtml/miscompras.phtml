<script>
  (function() {
    var tabPlanes   = document.getElementById('tabPlanes');
    var tabRecargas = document.getElementById('tabRecargas');
    var tablaPlanes = document.getElementById('tablaPlanes');
    var tablaRec    = document.getElementById('tablaRecargas');
    var recTbody    = document.getElementById('recTbody');
    var buscar      = document.getElementById('mcBuscar');
    var info        = document.getElementById('mcInfo');
    var prevBtn     = document.getElementById('mcPrev');
    var nextBtn     = document.getElementById('mcNext');
    var recRows     = [];
    var page        = 1;
    var per         = 10;
    if (!tabPlanes || !tabRecargas) return;

    function activarPlanes() {
      tablaPlanes.style.display = 'block';
      tablaRec.style.display    = 'none';
      tabPlanes.style.background  = '#ffffff';
      tabPlanes.style.color       = '#111827';
      tabPlanes.style.fontWeight  = '600';
      tabRecargas.style.background = '#f9fafb';
      tabRecargas.style.color      = '#4b5563';
      tabRecargas.style.fontWeight = '500';
    }

    function activarRecargas() {
      tablaPlanes.style.display = 'none';
      tablaRec.style.display    = 'block';
      tabPlanes.style.background   = '#f9fafb';
      tabPlanes.style.color        = '#4b5563';
      tabPlanes.style.fontWeight   = '500';
      tabRecargas.style.background = '#ffffff';
      tabRecargas.style.color      = '#111827';
      tabRecargas.style.fontWeight = '600';
      // cargar si vacío
      if (!recRows || recRows.length===0) { fetchRecargas(); }
    }

    tabPlanes.addEventListener('click', function(e) { e.preventDefault(); activarPlanes(); });
    tabRecargas.addEventListener('click', function(e) { e.preventDefault(); activarRecargas(); });

    // Activar por defecto la pestaña 'Recargas' para ejecutar el fetch al abrir la vista
    activarRecargas();

    function fmtDateIso(s){ try{ var d=new Date(s); if(isNaN(d.getTime())) return s||''; var pad=n=>(''+n).padStart(2,'0'); return d.getFullYear()+'-'+pad(d.getMonth()+1)+'-'+pad(d.getDate())+' '+pad(d.getHours())+':'+pad(d.getMinutes()); }catch(_){ return s||''; } }
    function dinero(v){ var n=parseFloat(v); if(!isFinite(n)) n=0; return '$'+n.toFixed(2); }

    function getFiltered(){ var q=(buscar&&buscar.value||'').toLowerCase(); return recRows.filter(function(r){ return !q || (String(r.cv_recarga||'').toLowerCase().indexOf(q)>-1) || (String(r.numero_telefono||'').toLowerCase().indexOf(q)>-1) || (String(r.nombre_comercial||'').toLowerCase().indexOf(q)>-1); }); }

    function setPager(){ var total=getFiltered().length; var pages=Math.max(1, Math.ceil(total/per)); if(prevBtn){ prevBtn.disabled=(page<=1||pages<=1);} if(nextBtn){ nextBtn.disabled=(page>=pages||pages<=1);} }

    function renderRec(){
      var data=getFiltered(); var total=data.length; if(total===0){ recTbody.innerHTML='<tr><td colspan="7" style="padding:16px 10px; text-align:center; color:#9ca3af;">Sin registros</td></tr>'; info.textContent='Mostrando 0 de 0'; setPager(); return; }
      var pages=Math.max(1, Math.ceil(total/per)); if(page>pages) page=pages; var start=(page-1)*per; var end=Math.min(start+per,total); var slice=data.slice(start,end);
      recTbody.innerHTML=slice.map(function(r){ var totalp=r.precio_likephone_wl||r.precio||0; return '<tr>'+
        '<td style="padding:10px; border-bottom:1px solid #f1f5f9;">'+(r.cv_recarga||'')+'</td>'+
        '<td style="padding:10px; border-bottom:1px solid #f1f5f9;">'+(r.numero_telefono||'')+'</td>'+
        '<td style="padding:10px; border-bottom:1px solid #f1f5f9;">'+(r.nombre_comercial||'')+'</td>'+
        '<td style="padding:10px; border-bottom:1px solid #f1f5f9;">'+fmtDateIso(r.fecha_recarga)+'</td>'+
        '<td style="padding:10px; border-bottom:1px solid #f1f5f9;">'+dinero(totalp)+'</td>'+
        '<td style="padding:10px; border-bottom:1px solid #f1f5f9;">'+(r.metodo_pago||'-')+'</td>'+
        '<td style="padding:10px; border-bottom:1px solid #f1f5f9;">'+((r.estatus_paquete==1)?'Activo':(r.estatus_paquete==0?'Pendiente':(r.estatus||'-')) )+'</td>'+
      '</tr>'; }).join('');
      info.textContent='Mostrando registros del '+(start+1)+' al '+end+' de un total de '+total+' registros'; setPager();
    }

    function fetchRecargas(){
      if(recTbody){ recTbody.innerHTML='<tr><td colspan="7" style="padding:16px 10px; text-align:center; color:#9ca3af;">Cargando…</td></tr>'; }
      fetch('<?php echo BASE_URL; ?>personas/userRechargesListComprasApi', {method:'POST'})
        .then(function(r){ return r.json().catch(function(){ return {ok:false}; }); })
        .then(function(j){ if(j&&j.ok){ recRows=(j.body&&j.body.data)? j.body.data: []; page=1; renderRec(); } else { recRows=[]; renderRec(); } })
        .catch(function(){ recRows=[]; renderRec(); });
    }

    buscar && buscar.addEventListener('input', function(){ if(tablaRec.style.display==='block'){ page=1; renderRec(); } });
    prevBtn && prevBtn.addEventListener('click', function(){ if(page>1){ page--; renderRec(); }});
    nextBtn && nextBtn.addEventListener('click', function(){ var total=getFiltered().length; var pages=Math.max(1, Math.ceil(total/per)); if(page<pages){ page++; renderRec(); }});
  })();
</script>
