      </div>
      <div style="display:flex; gap:10px;">
        <input id="pIcc" type="text" placeholder="ICC" inputmode="numeric" maxlength="22" oninput="this.value=this.value.replace(/\D+/g,'').slice(0,22);" style="flex:1; border:1px solid #d1d5db; border-radius:4px; padding:8px 10px; font-size:14px;" />
        <input id="pNip" type="text" placeholder="NIP" inputmode="numeric" maxlength="4" oninput="this.value=this.value.replace(/\D+/g,'').slice(0,4);" style="flex:1; border:1px solid #d1d5db; border-radius:4px; padding:8px 10px; font-size:14px;" />
