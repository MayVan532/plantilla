      $waNum = '';
      $scanValues = function($arr) use (&$waUrl,&$waNum,&$waMsg){
        foreach ($arr as $val){
          if (is_array($val)) { foreach ($val as $vv){ if (!is_string($vv)) continue; $s=trim($vv);
