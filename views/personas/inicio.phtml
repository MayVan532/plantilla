        <button type="button" id="plNext" style="position:absolute; right:6px; top:50%; transform:translateY(-50%); width:36px; height:36px; border-radius:999px; border:0; background:#ffffff; box-shadow:0 6px 14px rgba(0,0,0,0.12); cursor:pointer; z-index:5;">›</button>
